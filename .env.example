DATABASE_URL=postgresql://registry:registry@localhost:5432/customer_registry?schema=public

TELEGRAM_BOT_TOKEN=
# 仅群聊权限用；私聊已开放，可不填或留作群白名单
TELEGRAM_OPERATOR_IDS=123456789,987654321
# 授权录入群（群聊必填）；私聊不需要
TELEGRAM_ENTRY_CHAT_IDS=-1001234567890
TELEGRAM_ARCHIVE_CHAT_ID=-1001234567890

PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Yangon

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_SYSTEM_OPERATOR_TELEGRAM_ID=
ADMIN_CORS_ORIGINS=http://localhost:5173,https://duan-yu.com,https://www.duan-yu.com

ENABLE_SWAGGER=true
